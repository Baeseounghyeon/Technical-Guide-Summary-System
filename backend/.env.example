# 이 파일을 .env 로 복사해서 사용하세요. .env 는 Git에 올라가지 않습니다.

# DB (기본값: backend/data/app.db SQLite). 운영 시 PostgreSQL 예:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/techguide

# JWT 서명 키 (운영 시 반드시 32자 이상의 임의 문자열로 변경)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# 최초 실행 시 자동 생성되는 플랫폼 관리자 계정 (개발용)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-dev-password

# 요약 엔진
#   mock        가짜 요약 (설치·키 불필요)
#   claude_code 본인 Claude 구독 (Claude Code CLI 설치·로그인 필요, 개인 사용 전용)
#   claude      Claude API (API 키 필요, 다른 사람에게 서비스할 때)
LLM_PROVIDER=mock
# 동시에 요약할 섹션 수. claude_code 는 구독 사용량 한도가 있으므로 2 정도를 권장
LLM_CONCURRENCY=4

# LLM_PROVIDER=claude_code 일 때
# CLAUDE_CODE_PATH=C:\Users\사용자\.local\bin\claude.exe   (PATH 에 없을 때만)
CLAUDE_CODE_MODEL=opus
CLAUDE_CODE_TIMEOUT_SECONDS=900

# LLM_PROVIDER=claude 일 때
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# true: API 서버 안에서 Worker 도 함께 실행 (개발용, 터미널 하나로 충분)
# 운영에서는 false 로 두고 `python -m app.worker` 를 별도 프로세스로 실행
EMBEDDED_WORKER=true
